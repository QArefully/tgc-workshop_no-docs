{
  "name": "@shop/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/db/run-seed.ts",
    "reset": "tsx src/db/run-reset.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx --test \"src/**/*.test.ts\" test/config.test.ts test/delivery/deliveryRules.test.ts test/delivery/deliverySlotRules.test.ts test/support/run-integration-tests.test.ts test/support/seededDatabase.test.ts",
    "test:integration": "tsx test/support/run-integration-tests.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/type-provider-typebox": "^5.0.0",
    "@shop/catalog": "*",
    "@shop/contracts": "*",
    "@shop/localisation": "*",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0"
  }
}
